# Copie ce fichier en .env et remplis ce qui te concerne.

# Mot de passe pour ouvrir l'app (sinon un mot de passe est généré et affiché au démarrage)
APP_PASSWORD=

# Port du serveur
PORT=3000

# Clé API Claude (console.anthropic.com) — sert uniquement aux messages que les modèles de réponse ne couvrent pas
ANTHROPIC_API_KEY=

# Connexions aux plateformes : renseignées à l'étape des connexions
EBAY_TOKEN=
VINTED_TOKEN=
LEBONCOIN_TOKEN=
DEPOP_TOKEN=
SHOPIFY_TOKEN=
